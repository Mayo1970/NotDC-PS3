// NotDC 3j, DC bump map with ShadInstr 1 and 3 (modulate): the texel RGB is 1, so the colour keeps its RGB and its
// alpha takes the bump alpha (ShadInstr 1 comes with vertex alpha forced to 255).
#include "bump.cgh"

void main(
    float4 color : COLOR0,
    float2 tc0   : TEXCOORD0,
    float4 offs  : TEXCOORD1,

    uniform sampler2D tex0,

    out float4 oColor : COLOR
)
{
    oColor = float4(color.rgb, color.a * bump_alpha(tex2D(tex0, tc0), offs));
}

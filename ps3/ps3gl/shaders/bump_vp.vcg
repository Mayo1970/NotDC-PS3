// NotDC 3j: q3_vp without the clip plane; texcoord1 has 4 components, the offset colour that ps3gl binds
// as 4 normalised bytes from the u1 slot of ps3gl_vertex_t.
void main(
    float4 position : ATTR0,
    float4 color    : ATTR3,
    float2 tc0      : ATTR8,
    float4 offs     : ATTR9,

    uniform float4x4 mvp,

    out float4 oPosition : POSITION,
    out float4 oColor    : COLOR0,
    out float2 oTc0      : TEXCOORD0,
    out float4 oOffs     : TEXCOORD1
)
{
    oPosition = mul(mvp, position);
    oColor    = color;
    oTc0      = tc0;
    oOffs     = offs;
}

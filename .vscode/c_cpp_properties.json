{
    "configurations": [
        {
            "name": "PS3",
            "includePath": [
                "${workspaceFolder}/**",
                "${env:PS3DEV}/ppu/include",
                "${env:PS3DEV}/portlibs/ppu/include",
                "${env:PS3DEV}/portlibs/ppu/include/freetype2"
            ],
            "defines": [
                "_PS3",
                "__PS3__",
                "RELEASE",
                "CAIQUE_RAM_HOOKS"
            ],
            "compilerPath": "${env:PS3DEV}/ppu/bin/ppu-gcc.exe",
            "cStandard": "gnu11",
            "cppStandard": "gnu++14",
            "intelliSenseMode": "gcc-x64"
        }
    ],
    "version": 4
}
